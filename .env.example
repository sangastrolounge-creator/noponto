# Copie para .env e preencha. Nunca envie o .env para o git.

# Nome que aparece no app
APP_NOME=Turno+

# Chave que assina os logins. Gere com: openssl rand -hex 32
SECRET_KEY=

# Publicação pelo Traefik: só com PUBLICAR=true e o domínio em APP_HOST (sem https://)
PUBLICAR=false
APP_HOST=

# Endereço público completo (usado nos links de acesso dos funcionários). Ex.: https://dominio.com.br
PUBLIC_URL=

# true quando estiver em https (obrigatório em produção; a localização do celular só funciona em https)
COOKIE_SECURE=false

# false = ninguém novo cria conta de empresa pela página inicial
CADASTRO_ABERTO=true

# Contato exigido pelos serviços de notificação push. Ex.: mailto:voce@dominio.com.br
PUSH_CONTATO=

# Dono da plataforma (Painel Master). Vazio = a conta de gestor mais antiga.
ADMIN_EMAIL=

# Cobrança automática pelo Asaas (vazio = cobrança manual, registrada no Painel Master).
# Em testes use a chave do sandbox e ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_API_URL=
# Token que o Asaas envia nos avisos de pagamento. Gere com: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# Endereços extras que redirecionam para o PUBLIC_URL (www, endereço antigo).
# APP_REGRA_EXTRA=' || Host(`www.dominio.com.br`) || Host(`antigo.exemplo`)'
APP_REGRA_EXTRA=
# Os mesmos endereços, separados por vírgula: www.dominio.com.br,antigo.exemplo
HOSTS_REDIRECIONAR=

# Direct do Instagram -> CRM (Master -> CRM). Endereço do webhook: https://SEU_DOMINIO/webhooks/instagram
# Chave secreta do app da Meta (Meta for Developers -> Configurações do app -> Básico -> Chave secreta do app)
META_APP_SECRET=
# Palavra combinada que você inventa e cola também no painel da Meta. Gere com: openssl rand -hex 16
META_VERIFY_TOKEN=
# Opcional: token de acesso do Instagram, para o lead já nascer com o @ e o nome de quem escreveu
META_IG_TOKEN=
